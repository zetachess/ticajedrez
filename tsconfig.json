{
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "skipLibCheck": true, "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true, "rootDir": "./src", "outDir": "./dist",
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  }
}
